POSTGRES_DB=meetflow
POSTGRES_USER=meetflow
POSTGRES_PASSWORD=meetflow_dev
JWT_SECRET=troque-por-uma-chave-longa-com-no-minimo-64-caracteres-em-producao
MAIL_MODE=log
AWS_REGION=us-east-1
AWS_SES_FROM=no-reply@suaempresa.com.br
APP_FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080/api
APP_RUNTIME_MODE=local
STORAGE_MODE=filesystem
STORAGE_DATABASE_MAX_BYTES=12582912
DATABASE_POOL_SIZE=5

# Somente para executar a API serverless da Vercel fora da plataforma.
# Na Vercel, a integração Neon cria MEETFLOW_DB_URL automaticamente.
MEETFLOW_DB_URL=postgresql://usuario:senha@host/banco?sslmode=require
MEETFLOW_JWT_SECRET=troque-por-uma-chave-aleatoria-com-no-minimo-32-caracteres

# Opcional: habilita mensagens e notificações em tempo real no plano gratuito da Ably.
# Esta chave é exclusivamente do servidor e nunca deve usar o prefixo NEXT_PUBLIC_.
ABLY_API_KEY=

# E-mails transacionais gratuitos via Brevo (300 envios/dia no plano gratuito).
# A chave e o remetente ficam somente no servidor e nunca usam NEXT_PUBLIC_.
BREVO_API_KEY=
MEETFLOW_EMAIL_FROM=seu-email-verificado@exemplo.com
MEETFLOW_EMAIL_NAME=MeetFlow

# URL pública usada nos links de recuperação de senha. Na Vercel, o domínio de produção é detectado automaticamente.
MEETFLOW_PUBLIC_URL=http://localhost:3000

# Use true durante a validação: a Brevo aceita o pedido, mas não entrega e-mail real.
BREVO_SANDBOX=true

# Protege a rotina diária da Vercel que prepara os lembretes de 24h e 1h.
CRON_SECRET=gere-uma-chave-aleatoria-longa-e-exclusiva
